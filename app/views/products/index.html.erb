<h1>Loja de Gelo</h1>

<%= link_to "Novo gelo", new_product_path %>

<ul>
  <% @products.each do |product| %>
    <li>
      <strong><%= product.name %></strong> —
      <%= product.ice_type.capitalize %> —
      R$ <%= product.price %>
      |
      <%= link_to "Ver", product %>
      |
      <%= link_to "Editar", edit_product_path(product) %>
      |
      <%= button_to "Excluir",
            product,
            method: :delete,
            data: { turbo_confirm: "Tem certeza que deseja excluir este produto?" },
            form: { style: "display:inline" } %>
    </li>
  <% end %>
</ul>
