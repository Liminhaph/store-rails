<h1>Products</h1>

<%= link_to "New Product", new_product_path %>

<ul>
  <% @products.each do |product| %>
    <li>
      <%= link_to product.name, product %> |
      <%= link_to "Excluir", product,
          data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" } %>
    </li>
  <% end %>
</ul>

