<% if @product.errors.any? %>
  <div>
    <% @product.errors.full_messages.each do |msg| %>
      <p><%= msg %></p>
    <% end %>
  </div>
<% end %>

<%= form_with model: @product do |form| %>
  <div>
    <%= form.label :name, "Nome do gelo" %><br>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :ice_type %><br>
    <%= form.select :ice_type, Product.ice_types.keys %>
  </div>

  <div>
    <%= form.label :description, "Descrição" %><br>
    <%= form.rich_text_area :description %>
  </div>

  <div>
    <%= form.label :price, "Preço (R$)" %><br>
    <%= form.text_field :price %>
  </div>

  <div>
    <%= form.submit "Salvar gelo" %>
  </div>

  <div>
  <%= form.label :in_stock, "Em estoque?" %>
  <%= form.check_box :in_stock %>
  </div>

  <div class="field">
  <%= form.label :in_stock, "Produto em estoque?" %>
  <%= form.check_box :in_stock %>
</div>


<% end %>
